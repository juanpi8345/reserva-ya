        <mxCell id="reservaYa-cluster-prod-config-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=15;spacingTop=12;spacingRight=15;spacingBottom=12;fontSize=13;fontFamily=Helvetica;shadow=1;" value="&lt;b style=&quot;font-size: 15px; color: #b45f06;&quot;&gt;📌 High Availability &amp;amp; Zero Data Loss Production Specs&lt;/b&gt;&lt;hr style=&quot;margin: 8px 0;&quot;&gt;&lt;ul style=&quot;margin: 0; padding-left: 18px; line-height: 1.6;&quot;&gt;&lt;li&gt;&lt;b&gt;Replication Factor (RF) = 3:&lt;/b&gt; Cada partición cuenta con 1 Leader y 2 In-Sync Replicas (ISR) distribuidas en Broker 1, Broker 2 y Broker 3.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Durabilidad y Consistencia:&lt;/b&gt; Configuración con &lt;code&gt;min.insync.replicas = 2&lt;/code&gt; y productores con &lt;code&gt;acks = all&lt;/code&gt; (&lt;code&gt;-1&lt;/code&gt;) para garantizar cero pérdida de eventos ante caídas de nodos.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Escalabilidad Horizontal:&lt;/b&gt; 5 particiones en tópicos críticos (&lt;i&gt;booking.created&lt;/i&gt;, &lt;i&gt;payment.approved&lt;/i&gt;, &lt;i&gt;payment.failed&lt;/i&gt;) con mapeo 1:1 para 5 instancias concurrentes por Consumer Group.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="210" width="820" x="680" y="-634" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
